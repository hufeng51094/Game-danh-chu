<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Shark Type — Luyện gõ tiếng Anh</title>
  <style>
    :root { --ink:#08243b; --blue:#0877c9; --cyan:#55d6c2; --yellow:#ffd166; --red:#ff6b6b; }
    * { box-sizing:border-box; }
    body { margin:0; min-height:100vh; overflow-x:hidden; font-family:Inter,system-ui,sans-serif; color:var(--ink); background:#bfeeff; }
    button,input { font:inherit; }
    button { cursor:pointer; }
    .topbar { height:66px; display:flex; align-items:center; justify-content:space-between; padding:0 28px; background:#fffdf7; border-bottom:3px solid #9ed6e8; position:relative; z-index:20; }
    .brand { display:flex; align-items:center; gap:10px; font-size:21px; font-weight:900; }
    .brand-badge { width:42px; height:42px; display:grid; place-items:center; border-radius:50%; background:#dff7ff; font-size:25px; }
    .hud { display:flex; align-items:center; gap:18px; }
    .hud-item { text-align:center; min-width:58px; }
    .hud-item span { display:block; color:#668096; font-size:10px; font-weight:800; letter-spacing:.08em; text-transform:uppercase; }
    .hud-item strong { font-size:20px; }
    .lives { color:#f05b78; letter-spacing:3px; }
    .game { min-height:calc(100vh - 66px); position:relative; overflow:hidden; background:linear-gradient(180deg,#75d4ef 0 16%,#27a8d3 16% 74%,#138eb8 74% 100%); }
    .game:before { content:""; position:absolute; inset:16% 0 26%; opacity:.17; background:radial-gradient(circle at 10% 30%,#fff 0 2px,transparent 3px),radial-gradient(circle at 70% 65%,#fff 0 2px,transparent 3px); background-size:44px 44px; }
    .sun { position:absolute; width:120px; height:120px; border-radius:50%; top:-55px; left:-38px; background:rgba(255,245,176,.85); box-shadow:0 0 30px rgba(255,245,176,.7); }
    .island { position:absolute; bottom:16%; left:-30px; width:230px; height:65px; border-radius:60% 70% 20% 20%; background:#f3c866; border-top:8px solid #7db45a; }
    .palm { position:absolute; left:70px; bottom:70px; width:12px; height:95px; background:#76533a; transform:rotate(12deg); border-radius:8px; }
    .palm:before { content:"🌴"; position:absolute; left:-35px; top:-47px; font-size:58px; }
    .sea-bottom { position:absolute; left:0; right:0; bottom:0; height:25%; background:linear-gradient(180deg,#42b9bf,#f0a96c); opacity:.95; }
    .sea-bottom:before { content:""; position:absolute; width:100%; height:12px; top:-6px; background:repeating-linear-gradient(90deg,transparent 0 18px,rgba(255,255,255,.55) 18px 34px); }
    .shark { position:absolute; z-index:5; display:flex; align-items:center; gap:7px; transform:translateX(-50%); transition:transform .08s linear; }
    .shark-face { width:78px; height:42px; position:relative; border-radius:55% 45% 45% 55%; background:#6d8391; box-shadow:inset 0 -7px 0 rgba(44,71,84,.24); }
    .shark-face:before { content:""; position:absolute; right:-21px; top:14px; border-left:25px solid #6d8391; border-top:7px solid transparent; border-bottom:7px solid transparent; }
    .shark-face:after { content:""; position:absolute; left:-18px; top:-12px; border-right:24px solid #6d8391; border-top:15px solid transparent; transform:rotate(-18deg); }
    .shark-eye { position:absolute; right:17px; top:10px; width:6px; height:6px; border-radius:50%; background:#fff; box-shadow:1px 1px 0 #172f3d; }
    .shark-word { min-width:92px; padding:7px 12px; border:2px solid rgba(255,255,255,.8); border-radius:12px 12px 12px 4px; color:#15334a; background:#fffdf7; text-align:center; font-weight:900; font-size:16px; box-shadow:0 5px 12px rgba(10,63,94,.16); }
    .shark.active .shark-word { border-color:#ffd166; background:#fff4c7; transform:scale(1.05); }
    .bubble { position:absolute; border:2px solid rgba(255,255,255,.55); border-radius:50%; animation:floatBubble 4s linear infinite; }
    @keyframes floatBubble { to { transform:translateY(-170px); opacity:0; } }
    .controls { position:absolute; z-index:10; left:50%; bottom:18px; transform:translateX(-50%); width:min(620px,calc(100% - 28px)); }
    .meaning { margin-bottom:8px; color:#fff; text-align:center; font-size:15px; text-shadow:0 2px 4px rgba(0,69,107,.35); }
    .input-wrap { display:flex; gap:8px; padding:8px; border:2px solid rgba(255,255,255,.65); border-radius:18px; background:rgba(4,82,118,.42); backdrop-filter:blur(5px); }
    .input-wrap input { flex:1; min-width:0; height:52px; border:0; border-radius:12px; outline:none; padding:0 17px; color:#15334a; background:#fff; font-size:19px; font-weight:750; }
    .input-wrap input:focus { box-shadow:0 0 0 3px #ffd166; }
    .input-wrap button { width:78px; border:0; border-radius:12px; color:#fff; background:#f05b78; font-weight:900; box-shadow:0 4px 0 #bd3f58; }
    .progress-wrap { position:absolute; z-index:10; top:16px; left:50%; transform:translateX(-50%); width:min(420px,60%); }
    .progress-label { display:flex; justify-content:space-between; margin-bottom:6px; color:#fff; font-size:12px; font-weight:800; text-shadow:0 1px 3px #1d7897; }
    .progress { height:10px; overflow:hidden; border:2px solid rgba(255,255,255,.7); border-radius:99px; background:rgba(0,75,115,.25); }
    .progress div { height:100%; width:0; border-radius:99px; background:#ffd166; transition:width .25s; }
    .overlay { position:absolute; z-index:30; inset:0; display:grid; place-items:center; background:rgba(4,50,75,.55); backdrop-filter:blur(7px); }
    .overlay.hidden { display:none; }
    .modal { width:min(440px,calc(100% - 32px)); padding:34px 28px; border:3px solid #fff; border-radius:24px; background:#fffdf7; text-align:center; box-shadow:0 18px 50px rgba(7,70,105,.25); }
    .modal-icon { font-size:64px; }
    .modal h1 { margin:10px 0 8px; font-size:32px; }
    .modal p { margin:0 0 20px; color:#668096; }
    .modal button { width:100%; height:52px; border:0; border-radius:14px; color:#fff; background:#0877c9; font-weight:900; box-shadow:0 5px 0 #075a96; }
    .level-select { display:grid; grid-template-columns:repeat(5,1fr); gap:7px; margin:18px 0; }
    .level-dot { height:42px; border:2px solid #cae1e9; border-radius:10px; color:#668096; background:#edf8fb; font-weight:900; }
    .level-dot.open { border-color:#0877c9; color:#0877c9; }
    .level-dot.done { border-color:#4db89a; color:#fff; background:#4db89a; }
    .level-dot.current { border-color:#0877c9; color:#fff; background:#0877c9; }
    @media(max-width:650px){ .topbar{padding:0 12px}.brand{font-size:16px}.brand-badge{width:36px;height:36px}.hud{gap:5px}.hud-item{min-width:44px}.hud-item strong{font-size:17px}.shark-face{width:64px;height:36px}.shark-face:before{right:-17px}.shark-word{min-width:78px;font-size:14px}.progress-wrap{top:12px;width:55%}.island{width:160px}.palm{left:38px}.meaning{font-size:13px}.modal h1{font-size:27px} }
  </style>
</head>
<body>
  <header class="topbar">
    <div class="brand"><span class="brand-badge">🦈</span> Shark Type</div>
    <div class="hud">
      <div class="hud-item"><span>Màn</span><strong id="levelLabel">1/5</strong></div>
      <div class="hud-item"><span>Điểm</span><strong id="score">0</strong></div>
      <div class="hud-item"><span>Mạng</span><strong class="lives" id="lives">♥♥♥</strong></div>
    </div>
  </header>

  <main class="game" id="game">
    <div class="sun"></div><div class="island"></div><div class="palm"></div><div class="sea-bottom"></div>
    <div class="progress-wrap">
      <div class="progress-label"><span id="levelName">Màn 1 · Rặng san hô</span><span id="clearCount">0/8</span></div>
      <div class="progress"><div id="progressBar"></div></div>
    </div>

    <div class="controls">
      <div class="meaning" id="meaning">Chọn cá mập tương ứng!</div>
      <div class="input-wrap">
        <input id="answer" autocomplete="off" autocapitalize="off" spellcheck="false" placeholder="Gõ từ hoặc cụm từ tiếng Anh...">
        <button id="fire" type="button">Đánh</button>
      </div>
    </div>

    <div class="overlay" id="overlay">
      <div class="modal">
        <div class="modal-icon" id="modalIcon">🦈</div>
        <h1 id="modalTitle">Nhiệm vụ san hô</h1>
        <p id="modalText">Gõ từ tiếng Anh trước khi cá mập chạm đáy biển.</p>
        <div class="level-select" id="levelSelect"></div>
        <button id="startButton">BẮT ĐẦU MÀN 1</button>
      </div>
    </div>
  </main>

  <script>
    const levels = [
      { name:"Rặng san hô", target:8, speed:.000055, spawn:2200, words:[["fish","con cá"],["sea","biển"],["sun","mặt trời"],["boat","thuyền"],["blue","màu xanh"],["sand","cát"],["wave","sóng"],["shell","vỏ sò"],["coral","san hô"],["beach","bãi biển"]] },
      { name:"Thủy cung", target:9, speed:.000065, spawn:1900, words:[["dolphin","cá heo"],["turtle","con rùa"],["ocean","đại dương"],["swim","bơi"],["shark","cá mập"],["whale","cá voi"],["crab","con cua"],["pearl","viên ngọc"],["deep sea","biển sâu"],["water","nước"]] },
      { name:"Hang đá ngầm", target:10, speed:.000075, spawn:1650, words:[["brave","dũng cảm"],["adventure","cuộc phiêu lưu"],["treasure","kho báu"],["danger","nguy hiểm"],["island","hòn đảo"],["explore","khám phá"],["cave","hang động"],["anchor","mỏ neo"],["mystery","bí ẩn"],["captain","thuyền trưởng"]] },
      { name:"Con tàu ma", target:11, speed:.000087, spawn:1450, words:[["move forward","tiến về phía trước"],["stay alert","luôn cảnh giác"],["find the way","tìm đường"],["never give up","không bao giờ bỏ cuộc"],["work together","làm việc cùng nhau"],["follow the map","theo bản đồ"],["face the storm","đối mặt với cơn bão"],["cross the sea","vượt qua biển"],["hidden treasure","kho báu bị giấu"],["brave sailors","những thủy thủ dũng cảm"]] },
      { name:"Trận chiến cuối", target:12, speed:.000098, spawn:1250, words:[["The ocean is vast","Đại dương bao la"],["We are ready for adventure","Chúng tôi sẵn sàng phiêu lưu"],["Keep calm and swim on","Bình tĩnh và tiếp tục bơi"],["Every storm will pass","Mọi cơn bão rồi cũng qua"],["The treasure is close","Kho báu đang ở gần"],["Believe in yourself","Tin vào bản thân"],["Our ship sails forward","Con tàu của chúng ta tiến tới"],["Courage makes heroes","Dũng cảm tạo nên anh hùng"]] }
    ];

    const $=id=>document.getElementById(id);
    const game=$('game'), input=$('answer');
    let levelIndex=0, score=0, lives=3, cleared=0, sharks=[], running=false, lastTime=0, spawnTimer=0, used=[];
    let unlocked=Number(localStorage.getItem('sharkUnlocked')||1);

    function bubbles(){ for(let i=0;i<14;i++){ const b=document.createElement('div'); b.className='bubble'; b.style.width=b.style.height=(8+Math.random()*18)+'px'; b.style.left=(Math.random()*100)+'%'; b.style.bottom=(Math.random()*30)+'%'; b.style.animationDelay=(-Math.random()*4)+'s'; game.appendChild(b); } }
    bubbles();

    function renderLevelDots(){ const box=$('levelSelect'); box.innerHTML=''; for(let i=0;i<5;i++){ const b=document.createElement('button'); b.className='level-dot '+(i<unlocked-1?'done':i===levelIndex?'open':''); b.textContent=i+1; b.disabled=i+1>unlocked; b.onclick=()=>{ levelIndex=i; updateModal(); }; box.appendChild(b); } }
    function updateModal(){ $('levelLabel').textContent=`${levelIndex+1}/5`; $('levelName').textContent=`Màn ${levelIndex+1} · ${levels[levelIndex].name}`; $('startButton').textContent=`BẮT ĐẦU MÀN ${levelIndex+1}`; renderLevelDots(); }

    function showOverlay(title,text,icon='🦈',buttonText='TIẾP TỤC'){ $('modalTitle').textContent=title; $('modalText').textContent=text; $('modalIcon').textContent=icon; $('startButton').textContent=buttonText; $('overlay').classList.remove('hidden'); renderLevelDots(); }

    function resetGame(){ sharks.forEach(s=>s.el.remove()); sharks=[]; cleared=0; lives=3; used=[]; spawnTimer=0; running=true; lastTime=performance.now(); $('lives').textContent='♥♥♥'; $('score').textContent=score; $('clearCount').textContent=`0/${levels[levelIndex].target}`; $('progressBar').style.width='0%'; $('levelLabel').textContent=`${levelIndex+1}/5`; $('levelName').textContent=`Màn ${levelIndex+1} · ${levels[levelIndex].name}`; $('overlay').classList.add('hidden'); input.disabled=false; input.value=''; input.focus(); requestAnimationFrame(loop); }

    function randomWord(){ const list=levels[levelIndex].words; if(used.length>=list.length) used=[]; let choices=list.map((w,i)=>i).filter(i=>!used.includes(i)); const i=choices[Math.floor(Math.random()*choices.length)]; used.push(i); return list[i]; }

    function spawnShark(){ if(!running)return; const [word,meaning]=randomWord(); const el=document.createElement('div'); el.className='shark'; el.innerHTML=`<div class="shark-face"><span class="shark-eye"></span></div><div class="shark-word">${escapeHtml(word)}</div>`; const side=Math.random()<.5; const y=120+Math.random()*(game.clientHeight-280); el.style.top=y+'px'; el.style.left=(side?-50:game.clientWidth+50)+'px'; el.dataset.direction=side?'1':'-1'; el.dataset.word=word; game.appendChild(el); sharks.push({el,word,meaning,y,x:side?-50:game.clientWidth+50,dir:side?1:-1,phase:Math.random()*6}); }

    function escapeHtml(s){ return s.replace(/[&<>'"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c])); }

    function loop(now){ if(!running)return; const dt=Math.min(now-lastTime,40); lastTime=now; const cfg=levels[levelIndex]; spawnTimer+=dt; if(spawnTimer>cfg.spawn && sharks.length<5){ spawnTimer=0; spawnShark(); } sharks.forEach(s=>{ s.x+=s.dir*dt*cfg.speed*game.clientWidth*1.35; s.el.style.left=s.x+'px'; s.el.style.top=(s.y+Math.sin(now/500+s.phase)*7)+'px'; s.el.style.transform=`translateX(-50%) scaleX(${s.dir===1?1:-1})`; });
      const bottomLimit=game.clientHeight-205; for(let i=sharks.length-1;i>=0;i--){ const s=sharks[i]; const rect=s.el.getBoundingRect?.(); if((s.dir===1&&s.x>game.clientWidth+90)||(s.dir===-1&&s.x<-90)){ s.el.remove(); sharks.splice(i,1); loseLife(); } }
      updateActive(); if(running)requestAnimationFrame(loop);
    }

    function updateActive(){ const typed=input.value.toLowerCase().trim(); let matches=sharks.filter(s=>s.word.toLowerCase().startsWith(typed)&&typed); sharks.forEach(s=>s.el.classList.remove('active')); if(matches.length){ matches.sort((a,b)=>a.x-b.x); matches[0].el.classList.add('active'); $('meaning').textContent=matches[0].meaning; }else if(!typed){ $('meaning').textContent='Gõ từ tiếng Anh trên cá mập!'; } }

    function submit(){ if(!running)return; const typed=input.value.trim().toLower(); const match=sharks.find(s=>s.word.toLower().trim()===typed); if(!match){ if(typed) loseLife(true); input.select(); return; } const idx=sharks.indexOf(match); match.el.style.transition='transform .25s'; match.el.style.transform='translateX(-50%) scale(.1)'; match.el.remove(); sharks.splice(idx,1); score+=10+levelIndex*2+cleared; cleared++; $('score').textContent=score; $('clearCount').textContent=`${cleared}/${levels[levelIndex].target}`; $('progressBar').style.width=(cleared/levels[levelIndex].target*100)+'%'; input.value=''; $('meaning').textContent='Tuyệt vời! Câu tiếp theo đang đến!'; if(cleared>=levels[levelIndex].target) completeLevel(); }

    function loseLife(wrong=false){ if(!running)return; lives--; $('lives').textContent='♥'.repeat(lives)+'♡'.repeat(3-lives); if(wrong){ input.value=''; $('meaning').textContent='Chưa khớp — hãy gõ đúng từ trên cá mập!'; } if(lives<=0){ endGame(); } }
    function endGame(){ running=false; sharks.forEach(s=>s.el.remove()); sharks=[]; input.disabled=true; showOverlay('Thử lại nhé!',`Bạn đã ghi ${score} điểm ở màn ${levelIndex+1}.`, '🌊','CHƠI LẠI MÀN NÀY'); }
    function completeLevel(){ running=false; input.disabled=true; sharks.forEach(s=>s.el.remove()); sharks=[]; unlocked=Math.max(unlocked,Math.min(5,levelIndex+2)); localStorage.setItem('sharkUnlocked',unlocked); const final=levelIndex===4; showOverlay(final?'Bạn là vua đại dương!':'Qua màn thành công!',final?`Hoàn thành 5 màn với ${score} điểm. Bạn thật tuyệt!`:`Hoàn thành “${levels[levelIndex].name}” và mở màn tiếp theo.`,final?'🏆':'🎉',final?'CHƠI LẠI TỪ ĐẦU':`CHƠI MÀN ${levelIndex+2}`); }

    $('fire').onclick=submit; input.addEventListener('keydown',e=>{ if(e.key==='Enter')submit(); });
    $('startButton').onclick=()=>{ if(!$('overlay').classList.contains('hidden')){ if($('modalTitle').textContent==='Thử lại nhé!'){ lives=3; cleared=0; } else if($('modalTitle').textContent==='Qua màn thành công!'){ levelIndex++; score+=25; } else if($('modalTitle').textContent==='Bạn là vua đại dương!'){ levelIndex=0; score=0; lives=3; } resetGame(); } }; 
    renderLevelDots(); updateModal();
  </script>
</body>
</html>
