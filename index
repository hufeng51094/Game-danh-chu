<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Shark Type — Luyện gõ tiếng Anh</title>
  <style>
    :root { --ink:#08243b; --blue:#0877c9; --yellow:#ffd166; --red:#f05b78; }
    * { box-sizing:border-box; }
    body { margin:0; min-height:100vh; font-family:Inter,system-ui,sans-serif; color:var(--ink); background:#bfeeff; }
    button,input { font:inherit; }
    button { cursor:pointer; }
    .topbar { height:66px; display:flex; align-items:center; justify-content:space-between; padding:0 28px; background:#fffdf7; border-bottom:3px solid #9ed6e8; position:relative; z-index:20; }
    .brand { display:flex; align-items:center; gap:10px; font-size:21px; font-weight:900; }
    .brand-badge { width:42px; height:42px; display:grid; place-items:center; border-radius:50%; background:#dff7ff; font-size:25px; }
    .hud { display:flex; align-items:center; gap:18px; }
    .hud-item { text-align:center; min-width:58px; }
    .hud-item span { display:block; color:#668096; font-size:10px; font-weight:800; letter-spacing:.08em; text-transform:uppercase; }
    .hud-item strong { font-size:20px; }
    .lives { color:var(--red); letter-spacing:3px; }
    .game { height:calc(100vh - 66px); min-height:480px; position:relative; overflow:hidden; background:linear-gradient(180deg,#75d4ef 0 16%,#27a8d3 16% 74%,#138eb8 74%); }
    .game:before { content:""; position:absolute; inset:16% 0 26%; opacity:.17; background:radial-gradient(circle at 10% 30%,#fff 0 2px,transparent 3px),radial-gradient(circle at 70% 65%,#fff 0 2px,transparent 3px); background-size:44px 44px; pointer-events:none; }
    .sun { position:absolute; width:120px; height:120px; border-radius:50%; top:-55px; left:-38px; background:rgba(255,245,176,.85); }
    .island { position:absolute; bottom:16%; left:-30px; width:230px; height:65px; border-radius:60% 70% 20% 20%; background:#f3c866; border-top:8px solid #7db45a; }
    .palm { position:absolute; left:70px; bottom:70px; width:12px; height:95px; background:#76533a; transform:rotate(12deg); border-radius:8px; }
    .palm:before { content:"🌴"; position:absolute; left:-35px; top:-47px; font-size:58px; }
    .sea-bottom { position:absolute; left:0; right:0; bottom:0; height:25%; background:linear-gradient(180deg,#42b9bf,#f0a96c); }
    .shark { position:absolute; z-index:5; display:flex; align-items:center; gap:7px; transform:translateX(-50%); pointer-events:none; }
    .shark-face { width:68px; height:40px; position:relative; border-radius:55% 45% 45% 55%; background:#6d8391; box-shadow:inset 0 -7px 0 rgba(44,71,84,.24); }
    .shark-face:before { content:""; position:absolute; right:-21px; top:14px; border-left:25px solid #6d8391; border-top:7px solid transparent; border-bottom:7px solid transparent; }
    .shark-face:after { content:""; position:absolute; left:-16px; top:-10px; border-right:22px solid #6d8391; border-top:14px solid transparent; transform:rotate(-18deg); }
    .shark-eye { position:absolute; right:14px; top:10px; width:6px; height:6px; border-radius:50%; background:#fff; }
    .shark-word { min-width:82px; padding:7px 10px; border:2px solid #fff; border-radius:12px 12px 12px 4px; color:#15334a; background:#fffdf7; text-align:center; font-weight:900; font-size:15px; box-shadow:0 5px 12px #0a3f5e29; }
    .shark.active .shark-word { border-color:var(--yellow); background:#fff4c7; }
    .controls { position:absolute; z-index:10; left:50%; bottom:18px; transform:translateX(-50%); width:min(620px,calc(100% - 28px)); }
    .meaning { min-height:24px; margin-bottom:8px; color:#fff; text-align:center; font-size:15px; text-shadow:0 2px 4px #00456b; }
    .input-wrap { display:flex; gap:8px; padding:8px; border:2px solid #ffffffa6; border-radius:18px; background:#0452766b; }
    .input-wrap input { flex:1; min-width:0; height:52px; border:0; border-radius:12px; outline:none; padding:0 17px; color:#15334a; background:#fff; font-size:18px; font-weight:750; }
    .input-wrap input:focus { box-shadow:0 0 0 3px var(--yellow); }
    .input-wrap button,.modal button { border:0; border-radius:12px; color:#fff; background:var(--red); font-weight:900; }
    .input-wrap button { width:78px; box-shadow:0 4px 0 #bd3f58; }
    .progress-wrap { position:absolute; z-index:10; top:16px; left:50%; transform:translateX(-50%); width:min(420px,60%); }
    .progress-label { display:flex; justify-content:space-between; margin-bottom:6px; color:#fff; font-size:12px; font-weight:800; text-shadow:0 1px 3px #1d7897; }
    .progress { height:10px; overflow:hidden; border:2px solid #ffffffb3; border-radius:99px; background:#004b7340; }
    .progress div { height:100%; width:0; border-radius:inherit; background:var(--yellow); transition:width .25s; }
    .overlay { position:absolute; z-index:30; inset:0; display:grid; place-items:center; padding:16px; background:#04324b8c; backdrop-filter:blur(7px); }
    .overlay.hidden { display:none; }
    .modal { width:min(440px,100%); padding:28px; border:3px solid #fff; border-radius:24px; background:#fffdf7; text-align:center; box-shadow:0 18px 50px #07466940; }
    .modal-icon { font-size:60px; }
    .modal h1 { margin:8px 0; font-size:30px; }
    .modal p { color:#668096; }
    .modal button { width:100%; height:50px; background:var(--blue); box-shadow:0 5px 0 #075a96; }
    .level-select { display:grid; grid-template-columns:repeat(5,1fr); gap:7px; margin:18px 0; }
    .level-dot { height:42px; border:2px solid #cae1e9!important; color:#668096!important; background:#edf8fb!important; box-shadow:none!important; }
    .level-dot.open { border-color:var(--blue)!important; color:var(--blue)!important; }
    .level-dot.done { border-color:#4db89a!important; color:#fff!important; background:#4db89a!important; }
    @media(max-width:650px) { .topbar{padding:0 12px}.brand{font-size:16px}.brand-badge{width:36px;height:36px}.hud{gap:5px}.hud-item{min-width:44px}.hud-item strong{font-size:17px}.progress-wrap{top:12px;width:55%}.island{width:160px}.palm{left:38px}.meaning{font-size:13px}.modal h1{font-size:27px} }
  </style>
</head>
<body>
  <header class="topbar">
    <div class="brand"><span class="brand-badge">🦈</span> Shark Type</div>
    <div class="hud">
      <div class="hud-item"><span>Màn</span><strong id="levelLabel">1/5</strong></div>
      <div class="hud-item"><span>Điểm</span><strong id="score">0</strong></div>
      <div class="hud-item"><span>Mạng</span><strong class="lives" id="lives">♥♥♥</strong></div>
    </div>
  </header>
  <main class="game" id="game">
    <div class="sun"></div><div class="island"></div><div class="palm"></div><div class="sea-bottom"></div>
    <div class="progress-wrap"><div class="progress-label"><span id="levelName"></span><span id="clearCount">0/8</span></div><div class="progress"><div id="progressBar"></div></div></div>
    <div class="controls"><div class="meaning" id="meaning">Gõ từ tiếng Anh trên cá mập!</div><div class="input-wrap"><input id="answer" autocomplete="off" autocapitalize="off" spellcheck="false" placeholder="Gõ từ hoặc cụm từ tiếng Anh..." aria-label="Câu trả lời tiếng Anh"><button id="fire" type="button">Đánh</button></div></div>
    <div class="overlay" id="overlay"><section class="modal"><div class="modal-icon" id="modalIcon">🦈</div><h1 id="modalTitle">Nhiệm vụ san hô</h1><p id="modalText">Gõ từ tiếng Anh trước khi cá mập bơi qua màn hình.</p><div class="level-select" id="levelSelect"></div><button id="startButton">BẮT ĐẦU MÀN 1</button></section></div>
  </main>
<script>
'use strict';
const levels = [
  {name:'Rặng san hô',target:8,speed:75,spawn:2200,words:[['fish','con cá'],['sea','biển'],['sun','mặt trời'],['boat','thuyền'],['blue','màu xanh'],['sand','cát'],['wave','sóng'],['shell','vỏ sò'],['coral','san hô'],['beach','bãi biển']]},
  {name:'Thủy cung',target:9,speed:90,spawn:1900,words:[['dolphin','cá heo'],['turtle','con rùa'],['ocean','đại dương'],['swim','bơi'],['shark','cá mập'],['whale','cá voi'],['crab','con cua'],['pearl','viên ngọc'],['deep sea','biển sâu'],['water','nước']]},
  {name:'Hang đá ngầm',target:10,speed:105,spawn:1650,words:[['brave','dũng cảm'],['adventure','cuộc phiêu lưu'],['treasure','kho báu'],['danger','nguy hiểm'],['island','hòn đảo'],['explore','khám phá'],['cave','hang động'],['anchor','mỏ neo'],['mystery','bí ẩn'],['captain','thuyền trưởng']]},
  {name:'Con tàu ma',target:11,speed:120,spawn:1450,words:[['move forward','tiến về phía trước'],['stay alert','luôn cảnh giác'],['find the way','tìm đường'],['never give up','không bao giờ bỏ cuộc'],['work together','làm việc cùng nhau'],['follow the map','theo bản đồ'],['face the storm','đối mặt với cơn bão'],['cross the sea','vượt qua biển'],['hidden treasure','kho báu bị giấu'],['brave sailors','những thủy thủ dũng cảm']]},
  {name:'Trận chiến cuối',target:12,speed:135,spawn:1250,words:[['The ocean is vast','Đại dương bao la'],['We are ready for adventure','Chúng tôi sẵn sàng phiêu lưu'],['Keep calm and swim on','Bình tĩnh và tiếp tục bơi'],['Every storm will pass','Mọi cơn bão rồi cũng qua'],['The treasure is close','Kho báu đang ở gần'],['Believe in yourself','Tin vào bản thân'],['Our ship sails forward','Con tàu của chúng ta tiến tới'],['Courage makes heroes','Dũng cảm tạo nên anh hùng']]}
];
const $ = id => document.getElementById(id);
const game = $('game'), input = $('answer');
let levelIndex=0, score=0, lives=3, cleared=0, sharks=[], running=false, lastTime=0, spawnTimer=0, used=[];
let unlocked=Math.max(1,Math.min(5,Number(localStorage.getItem('sharkUnlocked'))||1));
function updateLevelInfo(){ $('levelLabel').textContent=`${levelIndex+1}/5`; $('levelName').textContent=`Màn ${levelIndex+1} · ${levels[levelIndex].name}`; }
function renderLevelDots(){
  const box=$('levelSelect'); box.replaceChildren();
  for(let i=0;i<5;i++){
    const button=document.createElement('button'); button.type='button';
    button.className=`level-dot ${i<unlocked-1?'done':i===levelIndex?'open':''}`; button.textContent=String(i+1); button.disabled=i>=unlocked;
    button.addEventListener('click',()=>{levelIndex=i;updateLevelInfo();renderLevelDots();$('startButton').textContent=`BẮT ĐẦU MÀN ${i+1}`;}); box.append(button);
  }
}
function showOverlay(title,text,icon,buttonText){ $('modalTitle').textContent=title; $('modalText').textContent=text; $('modalIcon').textContent=icon; $('startButton').textContent=buttonText; $('overlay').classList.remove('hidden'); renderLevelDots(); }
function resetGame(){
  sharks.forEach(shark=>shark.el.remove()); sharks=[]; cleared=0; lives=3; used=[]; spawnTimer=0; running=true; lastTime=performance.now();
  $('lives').textContent='♥♥♥'; $('score').textContent=String(score); $('clearCount').textContent=`0/${levels[levelIndex].target}`; $('progressBar').style.width='0%'; $('meaning').textContent='Gõ từ tiếng Anh trên cá mập!';
  updateLevelInfo(); $('overlay').classList.add('hidden'); input.disabled=false; input.value=''; input.focus(); requestAnimationFrame(loop);
}
function randomWord(){
  const words=levels[levelIndex].words;
  if(used.length>=words.length) used=[];
  const choices=words.map((_,i)=>i).filter(i=>!used.includes(i));
  const index=choices[Math.floor(Math.random()*choices.length)]; used.push(index); return words[index];
}
function spawnShark(){
  if(!running)return;
  const [word,meaning]=randomWord(), el=document.createElement('div'), face=document.createElement('div'), eye=document.createElement('span'), label=document.createElement('div');
  el.className='shark'; face.className='shark-face'; eye.className='shark-eye'; label.className='shark-word'; label.textContent=word; face.append(eye); el.append(face,label);
  const dir=Math.random()<.5?1:-1, x=dir===1?-55:game.clientWidth+55, y=105+Math.random()*Math.max(20,game.clientHeight-290);
  el.style.left=`${x}px`; el.style.top=`${y}px`; el.style.transform=`translateX(-50%) scaleX(${dir})`; game.append(el); sharks.push({el,word,meaning,x,y,dir,phase:Math.random()*6});
}
function updateActive(){
  const typed=input.value.toLowerCase().trim(); let candidates=typed?sharks.filter(s=>s.word.toLowerCase().startsWith(typed)):[];
  sharks.forEach(s=>s.el.classList.remove('active'));
  if(candidates.length){ candidates.sort((a,b)=>a.x-b.x); candidates[0].el.classList.add('active'); $('meaning').textContent=candidates[0].meaning; }
  else $('meaning').textContent=typed?'Không có cá mập nào khớp với phần chữ đã gõ.':'Gõ từ tiếng Anh trên cá mập!';
}
function loseLife(wrong=false){
  if(!running)return; lives--; $('lives').textContent='♥'.repeat(Math.max(0,lives))+'♡'.repeat(Math.max(0,3-lives));
  if(wrong){input.value='';$('meaning').textContent='Chưa khớp — hãy gõ đúng từ trên cá mập!';}
  if(lives<=0) endGame();
}
function submit(){
  if(!running)return; const typed=input.value.trim().toLowerCase(); if(!typed)return;
  const index=sharks.findIndex(s=>s.word.trim().toLowerCase()===typed);
  if(index<0){loseLife(true);input.focus();return;}
  sharks[index].el.remove(); sharks.splice(index,1); score+=10+levelIndex*2+cleared; cleared++;
  $('score').textContent=String(score); $('clearCount').textContent=`${cleared}/${levels[levelIndex].target}`; $('progressBar').style.width=`${cleared/levels[levelIndex].target*100}%`;
  input.value=''; $('meaning').textContent='Tuyệt vời! Câu tiếp theo đang đến!';
  if(cleared>=levels[levelIndex].target) completeLevel(); else input.focus();
}
function endGame(){
  running=false; sharks.forEach(s=>s.el.remove()); sharks=[]; input.disabled=true;
  showOverlay('Thử lại nhé!',`Bạn đã ghi ${score} điểm ở màn ${levelIndex+1}.`,'🌊','CHƠI LẠI MÀN NÀY');
}
function completeLevel(){
  running=false; input.disabled=true; sharks.forEach(s=>s.el.remove()); sharks=[];
  unlocked=Math.max(unlocked,Math.min(5,levelIndex+2)); localStorage.setItem('sharkUnlocked',String(unlocked));
  const final=levelIndex===levels.length-1;
  showOverlay(final?'Bạn là vua đại dương!':'Qua màn thành công!',final?`Hoàn thành 5 màn với ${score} điểm. Bạn thật tuyệt!`:`Hoàn thành “${levels[levelIndex].name}” và mở màn tiếp theo.`,final?'🏆':'🎉',final?'CHƠI LẠI TỪ ĐẦU':`CHƠI MÀN ${levelIndex+2}`);
}
function loop(now){
  if(!running)return; const dt=Math.min(now-lastTime,50)/1000; lastTime=now; const cfg=levels[levelIndex]; spawnTimer+=dt*1000;
  if(spawnTimer>=cfg.spawn&&sharks.length<5){spawnTimer=0;spawnShark();}
  for(let i=sharks.length-1;i>=0;i--){
    const s=sharks[i]; s.x+=s.dir*cfg.speed*dt; s.el.style.left=`${s.x}px`; s.el.style.top=`${s.y+Math.sin(now/500+s.phase)*7}px`;
    if((s.dir===1&&s.x>game.clientWidth+100)||(s.dir===-1&&s.x< -100)){s.el.remove();sharks.splice(i,1);loseLife();if(!running)return;}
  }
  updateActive(); requestAnimationFrame(loop);
}
$('fire').addEventListener('click',submit); input.addEventListener('keydown',event=>{if(event.key==='Enter'){event.preventDefault();submit();}});
$('startButton').addEventListener('click',()=>{
  const title=$('modalTitle').textContent;
  if(title==='Thử lại nhé!'){lives=3;}
  else if(title==='Qua màn thành công!'){levelIndex=Math.min(levelIndex+1,levels.length-1);score+=25;}
  else if(title==='Bạn là vua đại dương!'){levelIndex=0;score=0;}
  resetGame();
});
updateLevelInfo(); renderLevelDots();
</script>
</body>
</html>
