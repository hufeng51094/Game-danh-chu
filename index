<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#101426">
  <title>Word Sprint — Luyện gõ tiếng Anh</title>
  <style>
    :root {
      color-scheme: dark;
      --bg: #101426;
      --panel: #191f35;
      --panel-light: #202842;
      --text: #f5f6ff;
      --muted: #9ba5c3;
      --purple: #a78bfa;
      --cyan: #67e8f9;
      --green: #6ee7b7;
      --red: #fb7185;
      --border: rgba(192, 203, 255, .12);
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      min-height: 100vh;
      padding: 32px 18px;
      display: grid;
      place-items: center;
      color: var(--text);
      background: radial-gradient(ellipse at 50% 0%, #27234b 0, var(--bg) 55%);
      font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }
    button, input, select { font: inherit; }
    button { cursor: pointer; }
    .app { width: min(100%, 850px); }
    header { text-align: center; margin-bottom: 26px; }
    .logo { display: inline-flex; align-items: center; gap: 10px; margin-bottom: 9px; color: var(--cyan); font-size: 13px; font-weight: 800; letter-spacing: .16em; text-transform: uppercase; }
    .logo-icon { display: grid; width: 34px; height: 34px; place-items: center; border: 1px solid rgba(103,232,249,.3); border-radius: 11px; background: rgba(103,232,249,.08); font-size: 17px; }
    h1 { margin: 0; font-size: clamp(30px, 6vw, 46px); letter-spacing: -.045em; }
    h1 span { color: var(--purple); }
    .subtitle { margin: 9px 0 0; color: var(--muted); font-size: 15px; }
    .game-card { overflow: hidden; border: 1px solid var(--border); border-radius: 24px; background: rgba(25,31,53,.94); box-shadow: 0 24px 80px rgba(0,0,0,.32); }
    .toolbar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px; padding: 18px 22px; border-bottom: 1px solid var(--border); }
    .difficulty { display: flex; align-items: center; gap: 10px; color: var(--muted); font-size: 13px; }
    select { padding: 9px 34px 9px 12px; border: 1px solid var(--border); border-radius: 10px; outline: none; color: var(--text); background: var(--panel-light); }
    select:focus, input:focus { border-color: var(--purple); box-shadow: 0 0 0 3px rgba(167,139,250,.15); }
    .toolbar-note { color: var(--muted); font-size: 12px; }
    .stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; padding: 20px 22px 4px; }
    .stat { padding: 13px 15px; border: 1px solid var(--border); border-radius: 14px; background: rgba(255,255,255,.025); }
    .stat-label { display: block; margin-bottom: 5px; color: var(--muted); font-size: 11px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
    .stat-value { font-size: 23px; font-weight: 800; font-variant-numeric: tabular-nums; }
    .stat-value.time { color: var(--cyan); }
    .stat-value.streak { color: var(--purple); }
    .play-area { padding: 22px; }
    .progress-head { display: flex; justify-content: space-between; margin-bottom: 9px; color: var(--muted); font-size: 12px; }
    .progress-track { height: 6px; overflow: hidden; border-radius: 99px; background: rgba(255,255,255,.08); }
    .progress-fill { width: 100%; height: 100%; border-radius: inherit; background: linear-gradient(90deg, var(--purple), var(--cyan)); transition: width .25s ease; }
    .prompt-box { min-height: 184px; margin: 22px 0 16px; padding: 25px; display: flex; flex-direction: column; justify-content: center; align-items: center; text-align: center; border: 1px solid var(--border); border-radius: 18px; background: linear-gradient(145deg, rgba(167,139,250,.08), rgba(103,232,249,.035)); }
    .prompt-kicker { margin-bottom: 12px; color: var(--muted); font-size: 12px; font-weight: 700; letter-spacing: .09em; text-transform: uppercase; }
    .translation { font-size: clamp(22px, 4vw, 31px); font-weight: 750; line-height: 1.35; }
    .hint { margin-top: 12px; color: var(--muted); font-size: 13px; }
    .target { min-height: 35px; margin: 0 0 12px; overflow-wrap: anywhere; text-align: center; color: #7883a4; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: clamp(15px, 2.8vw, 20px); letter-spacing: .02em; line-height: 1.6; }
    .target .correct { color: var(--green); }
    .target .wrong { color: var(--red); text-decoration: underline; text-decoration-color: var(--red); }
    .target .cursor { border-left: 2px solid var(--cyan); animation: blink 1s steps(2) infinite; }
    @keyframes blink { 50% { border-color: transparent; } }
    .input-row { display: flex; gap: 10px; }
    .typing-input { flex: 1; min-width: 0; padding: 15px 16px; border: 1px solid var(--border); border-radius: 13px; outline: none; color: var(--text); background: #11172a; font-size: 16px; transition: .2s; }
    .typing-input::placeholder { color: #6f7896; }
    .primary, .secondary { border: 0; border-radius: 12px; font-weight: 750; transition: transform .15s, opacity .15s; }
    .primary:hover, .secondary:hover { transform: translateY(-1px); }
    .primary { padding: 0 21px; color: #17142a; background: linear-gradient(135deg, #c4b5fd, #67e8f9); }
    .secondary { padding: 10px 15px; border: 1px solid var(--border); color: var(--text); background: var(--panel-light); }
    button:disabled, input:disabled { opacity: .55; cursor: not-allowed; }
    .feedback { min-height: 25px; padding-top: 10px; text-align: center; color: var(--muted); font-size: 13px; }
    .feedback.good { color: var(--green); }
    .feedback.bad { color: var(--red); }
    .bottom-row { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-top: 7px; }
    .best { color: var(--muted); font-size: 12px; }
    .best strong { color: var(--purple); }
    .help { margin: 18px 4px 0; color: var(--muted); text-align: center; font-size: 12px; line-height: 1.7; }
    .help kbd { padding: 2px 6px; border: 1px solid var(--border); border-radius: 5px; color: #d7dcf3; background: var(--panel); font-family: inherit; }
    @media (max-width: 560px) {
      body { padding: 22px 12px; }
      .toolbar, .play-area { padding-left: 15px; padding-right: 15px; }
      .stats { gap: 7px; padding-left: 15px; padding-right: 15px; }
      .stat { padding: 11px 9px; }
      .stat-label { font-size: 9px; letter-spacing: .04em; }
      .stat-value { font-size: 19px; }
      .prompt-box { min-height: 155px; padding: 20px 14px; }
      .primary { padding: 0 14px; }
      .toolbar-note { display: none; }
    }
  </style>
</head>
<body>
  <main class="app">
    <header>
      <div class="logo"><span class="logo-icon">⌨</span> English typing practice</div>
      <h1>Word <span>Sprint</span></h1>
      <p class="subtitle">Luyện gõ nhanh, ghi nhớ từ vựng tiếng Anh mỗi ngày.</p>
    </header>

    <section class="game-card" aria-label="Trò chơi luyện gõ tiếng Anh">
      <div class="toolbar">
        <label class="difficulty" for="level">Độ khó
          <select id="level" aria-label="Chọn độ khó">
            <option value="easy">Dễ · Từ đơn</option>
            <option value="medium" selected>Vừa · Cụm từ</option>
            <option value="hard">Khó · Câu ngắn</option>
          </select>
        </label>
        <span class="toolbar-note">60 giây · Gõ câu tiếng Anh theo nghĩa tiếng Việt</span>
        <button class="secondary" id="restart" type="button">↻ Chơi lại</button>
      </div>

      <div class="stats" aria-live="polite">
        <div class="stat"><span class="stat-label">Thời gian</span><span class="stat-value time" id="time">60</span></div>
        <div class="stat"><span class="stat-label">Điểm</span><span class="stat-value" id="score">0</span></div>
        <div class="stat"><span class="stat-label">Độ chính xác</span><span class="stat-value" id="accuracy">100%</span></div>
        <div class="stat"><span class="stat-label">Chuỗi đúng</span><span class="stat-value streak" id="streak">0</span></div>
      </div>

      <div class="play-area">
        <div class="progress-head"><span id="status">Sẵn sàng? Bắt đầu gõ nhé!</span><span id="round">Câu 1</span></div>
        <div class="progress-track" role="progressbar" aria-label="Thời gian còn lại" aria-valuemin="0" aria-valuemax="60" aria-valuenow="60"><div class="progress-fill" id="progress"></div></div>

        <div class="prompt-box">
          <div class="prompt-kicker">Hãy viết bằng tiếng Anh</div>
          <div class="translation" id="translation">Chọn một mục tiêu và kiên trì mỗi ngày.</div>
          <div class="hint" id="hint">Gợi ý: một từ sẽ xuất hiện ở đây</div>
        </div>

        <div class="target" id="target" aria-hidden="true"></div>
        <form class="input-row" id="answer-form" autocomplete="off">
          <input class="typing-input" id="answer" type="text" placeholder="Gõ câu trả lời tiếng Anh..." aria-label="Câu trả lời tiếng Anh" autocapitalize="off" spellcheck="false">
          <button class="primary" id="submit" type="submit">Nhập ↵</button>
        </form>
        <div class="feedback" id="feedback" role="status" aria-live="polite">Nhấn vào ô nhập để bắt đầu tính giờ.</div>
        <div class="bottom-row">
          <span class="best">Kỷ lục: <strong id="best">0</strong> điểm</span>
          <button class="secondary" id="skip" type="button">Bỏ qua →</button>
        </div>
      </div>
    </section>
    <p class="help">Mẹo: gõ đáp án rồi nhấn <kbd>Enter</kbd> để xác nhận. Mỗi đáp án đúng được <strong>10 điểm</strong> + thưởng tốc độ!</p>
  </main>

  <script>
    const vocabulary = {
      easy: [
        ['apple', 'quả táo'], ['book', 'quyển sách'], ['bright', 'sáng, rực rỡ'], ['careful', 'cẩn thận'], ['dream', 'ước mơ'],
        ['family', 'gia đình'], ['friend', 'bạn bè'], ['garden', 'khu vườn'], ['happy', 'vui vẻ'], ['journey', 'hành trình'],
        ['kindness', 'lòng tốt'], ['learn', 'học'], ['morning', 'buổi sáng'], ['nature', 'thiên nhiên'], ['practice', 'luyện tập'],
        ['quiet', 'yên tĩnh'], ['smile', 'nụ cười'], ['strong', 'mạnh mẽ'], ['travel', 'du lịch'], ['wonderful', 'tuyệt vời'],
        ['healthy', 'khỏe mạnh'], ['discover', 'khám phá'], ['courage', 'lòng can đảm'], ['beautiful', 'xinh đẹp']
      ],
      medium: [
        ['good morning', 'chào buổi sáng'], ['take your time', 'cứ từ từ, không cần vội'], ['learn something new', 'học điều gì đó mới'],
        ['keep going', 'tiếp tục cố gắng'], ['a cup of tea', 'một tách trà'], ['make a difference', 'tạo nên sự khác biệt'],
        ['believe in yourself', 'tin tưởng vào bản thân'], ['spend time wisely', 'sử dụng thời gian khôn ngoan'],
        ['open your mind', 'mở rộng tâm trí'], ['small steps matter', 'những bước nhỏ rất quan trọng'],
        ['enjoy the moment', 'tận hưởng khoảnh khắc hiện tại'], ['follow your dreams', 'theo đuổi ước mơ của bạn'],
        ['give it a try', 'hãy thử một lần'], ['never stop learning', 'đừng bao giờ ngừng học hỏi'],
        ['under the weather', 'cảm thấy không khỏe'], ['better late than never', 'muộn còn hơn không'],
        ['make yourself at home', 'cứ tự nhiên như ở nhà'], ['practice makes progress', 'luyện tập giúp bạn tiến bộ'],
        ['look on the bright side', 'hãy nhìn vào mặt tích cực'], ['actions speak louder than words', 'hành động có giá trị hơn lời nói']
      ],
      hard: [
        ['I learn something new every day.', 'Tôi học một điều mới mỗi ngày.'],
        ['The best way to learn is to practice.', 'Cách tốt nhất để học là luyện tập.'],
        ['Small steps can lead to big changes.', 'Những bước nhỏ có thể dẫn đến thay đổi lớn.'],
        ['Believe in yourself and keep moving forward.', 'Hãy tin vào bản thân và tiếp tục tiến về phía trước.'],
        ['A little progress each day adds up to success.', 'Một chút tiến bộ mỗi ngày sẽ góp lại thành công.'],
        ['Reading opens the door to new ideas.', 'Đọc sách mở ra cánh cửa đến những ý tưởng mới.'],
        ['Kind words can make someone feel better.', 'Lời nói tử tế có thể khiến ai đó cảm thấy tốt hơn.'],
        ['Take a deep breath and do your best.', 'Hãy hít thở sâu và cố gắng hết sức.'],
        ['Learning a language takes time and patience.', 'Học một ngôn ngữ cần thời gian và sự kiên nhẫn.'],
        ['Every mistake is a chance to improve.', 'Mỗi sai lầm là một cơ hội để tiến bộ.'],
        ['Today is a great day to start something new.', 'Hôm nay là ngày tuyệt vời để bắt đầu điều mới.'],
        ['Success comes to those who never give up.', 'Thành công đến với những người không bao giờ bỏ cuộc.']
      ]
    };

    const $ = (id) => document.getElementById(id);
    const answerInput = $('answer');
    let timeLeft = 60, score = 0, correctCount = 0, attempts = 0, streak = 0;
    let questionNumber = 1, current = null, timer = null, started = false, running = false;
    let previousIndex = -1;
    const bestKey = 'wordSprintBest';
    $('best').textContent = localStorage.getItem(bestKey) || '0';

    function setFeedback(message, kind = '') {
      const box = $('feedback');
      box.textContent = message;
      box.className = `feedback ${kind}`;
    }
    function newQuestion() {
      const list = vocabulary[$('level').value];
      let index = Math.floor(Math.random() * list.length);
      if (list.length > 1 && index === previousIndex) index = (index + 1) % list.length;
      previousIndex = index;
      current = list[index];
      $('translation').textContent = current[1];
      $('hint').textContent = $('level').value === 'easy' ? 'Gợi ý: một từ tiếng Anh' : $('level').value === 'medium' ? 'Gợi ý: cụm từ tiếng Anh' : 'Gợi ý: chú ý viết hoa và dấu câu';
      $('round').textContent = `Câu ${questionNumber}`;
      answerInput.value = '';
      renderTarget();
      if (running) answerInput.focus();
    }
    function renderTarget() {
      if (!current) return;
      const typed = answerInput.value;
      const expected = current[0];
      $('target').innerHTML = Array.from(expected).map((char, i) => {
        let className = '';
        if (i < typed.length) className = typed[i].toLowerCase() === char.toLowerCase() ? 'correct' : 'wrong';
        const safeChar = char === ' ' ? '&nbsp;' : char.replaceAll('&', '&amp;').replaceAll('<', '&lt;').replaceAll('>', '&gt;');
        return `<span class="${className}${i === typed.length ? ' cursor' : ''}">${safeChar}</span>`;
      }).join('');
    }
    function startGame() {
      if (started || !running) return;
      started = true;
      $('status').textContent = 'Đang chơi — cố lên!';
      setFeedback('Bắt đầu thôi! Gõ đúng để ghi điểm.', '');
      timer = setInterval(() => {
        timeLeft--;
        updateStats();
        if (timeLeft <= 0) endGame();
      }, 1000);
    }
    function updateStats() {
      $('time').textContent = timeLeft;
      $('score').textContent = score;
      $('accuracy').textContent = `${attempts ? Math.round(correctCount / attempts * 100) : 100}%`;
      $('streak').textContent = streak;
      $('progress').style.width = `${timeLeft / 60 * 100}%`;
      document.querySelector('[role="progressbar"]').setAttribute('aria-valuenow', timeLeft);
      $('time').style.color = timeLeft <= 10 ? 'var(--red)' : '';
    }
    function submitAnswer(event) {
      event.preventDefault();
      if (!running) return;
      startGame();
      const typed = answerInput.value.trim();
      if (!typed) { answerInput.focus(); return; }
      attempts++;
      if (typed.toLowerCase() === current[0].toLowerCase()) {
        correctCount++;
        streak++;
        const bonus = Math.max(0, Math.ceil(timeLeft / 10));
        score += 10 + bonus;
        questionNumber++;
        updateStats();
        setFeedback(`Chính xác! +${10 + bonus} điểm ✨`, 'good');
        newQuestion();
      } else {
        streak = 0;
        updateStats();
        setFeedback('Chưa đúng rồi, thử lại nhé! (Không phân biệt chữ hoa/thường)', 'bad');
        renderTarget();
        answerInput.focus();
      }
    }
    function skipQuestion() {
      if (!running) return;
      startGame();
      attempts++;
      streak = 0;
      questionNumber++;
      updateStats();
      setFeedback(`Đáp án: ${current[0]}`, '');
      newQuestion();
    }
    function endGame() {
      clearInterval(timer);
      timer = null;
      running = false;
      timeLeft = 0;
      answerInput.disabled = true;
      $('submit').disabled = true;
      $('skip').disabled = true;
      $('level').disabled = false;
      $('status').textContent = 'Hết giờ!';
      const oldBest = Number(localStorage.getItem(bestKey) || 0);
      if (score > oldBest) {
        localStorage.setItem(bestKey, score);
        $('best').textContent = score;
        setFeedback(`Hết giờ! Bạn đạt ${score} điểm — kỷ lục mới! 🏆`, 'good');
      } else {
        setFeedback(`Hết giờ! Bạn đạt ${score} điểm. Bấm “Chơi lại” để thử lần nữa!`, '');
      }
      updateStats();
    }
    function restartGame() {
      clearInterval(timer);
      timer = null;
      timeLeft = 60; score = 0; correctCount = 0; attempts = 0; streak = 0; questionNumber = 1;
      started = false; running = true;
      answerInput.disabled = false;
      $('submit').disabled = false;
      $('skip').disabled = false;
      $('level').disabled = true;
      $('status').textContent = 'Sẵn sàng? Bắt đầu gõ nhé!';
      updateStats();
      setFeedback('Nhấn vào ô nhập để bắt đầu tính giờ.', '');
      newQuestion();
      answerInput.focus();
    }
    $('answer-form').addEventListener('submit', submitAnswer);
    answerInput.addEventListener('input', () => { if (!running) return; startGame(); renderTarget(); });
    $('skip').addEventListener('click', skipQuestion);
    $('restart').addEventListener('click', restartGame);
    $('level').addEventListener('change', () => { if (!started) newQuestion(); });
    restartGame();
  </script>
</body>
</html>
